{
  "name": "cup-pulse-pear",
  "productName": "CupPulse",
  "version": "0.1.0",
  "upgrade": "pear://yhdoqba8yhdoqba8yhdoqba8yhdoqba8yhdoqba8yhdoqba8yhdo",
  "description": "P2P fan war room for tournament predictions and watch-party pipelines on the Pears Stack",
  "license": "MIT",
  "author": "cubiczan",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "start": "electron-forge start -- --no-updates",
    "start:peer": "electron-forge start -- --no-updates --storage /tmp/cup-pulse-peer-2",
    "repair:electron": "node scripts/repair-electron.mjs",
    "record:demo": "bash scripts/record-demo-ffmpeg.sh",
    "record:demo:ui": "bash scripts/record-demo-ui.sh",
    "record:demo:live": "bash scripts/record-demo-screen.sh",
    "postinstall": "node scripts/verify-electron.mjs || true",
    "test": "node --test test/*.test.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "corestore": "^7.9.1",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.1.4",
    "which-runtime": "^1.3.2"
  },
  "optionalDependencies": {
    "agora-rtc-sdk-ng": "^4.24.7",
    "agora-token": "^2.0.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "app-builder-lib": "^26.8.1",
    "electron": "^40.2.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^0.0.10",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  }
}
